# Server Configuration
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Concurrency, Job Limits & Cron Scheduling
STREAM_CONCURRENCY=1
MAX_JOB_LIMIT=2
LOT_CONCURRENCY=2
LOT_MAX_RETRIES=3
RENDER_THREADS=4
RENDER_TIMEOUT_MS=300000
RENDERER_VERSION=1.0.0
CRON_INTERVAL_MS=300000

# Scratch and Cache Directories
SCRATCH_DIR=/tmp/auction-reels-scratch
THEME_CACHE_DIR=/tmp/reel-themes

# Storage & Database Configuration
# STORAGE_PROVIDER options: gcp | aws
STORAGE_PROVIDER=gcp
FIRESTORE_JOBS_COLLECTION=auction_reels_jobs

# Speech-to-Text (STT) Routing
# STT_PROVIDER options: zoop | groq | openrouter
STT_PROVIDER=zoop
STT_ZOOP_URL=http://stt-inference:8000
STT_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/whisper-large-v3

# GCP & Firebase
GCP_PROJECT_ID=zoop-408211
# Service account used for Firestore. Set ONE of these (JSON wins if both are set);
# leave both empty to fall back to Application Default Credentials (gcloud / workload identity).
# GCP_SERVICE_ACCOUNT_JSON accepts raw JSON or base64-encoded JSON (base64 is easiest in .env / k8s secrets).
# GCP_SERVICE_ACCOUNT_KEY_PATH is a path to the key file (inside the container when running in Docker).
GCP_SERVICE_ACCOUNT_JSON=
GCP_SERVICE_ACCOUNT_KEY_PATH=
REELS_BUCKET=zoop-auction-reels-prod
THEMES_BUCKET=zoop-reel-themes-prod

# AWS S3 (Livestream HLS segments read-only & AWS storage fallback)
S3_BUCKET=zoop-live-stream-prod-bucket
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ZOOP_CDN_BASE_URL=https://cdn-prod.zooplive.com

# Internal Zoop Microservices
SHARE_LEADERBOARD_URL=http://share-leaderboard-service:8080
LIVESTREAM_URL=http://livestream-service:8080
X_API_SIGN_TOKEN=

# Auth
ADMIN_JWT_SECRET=super-secret-jwt-key

# Debug / Seed Script (Optional)
# STREAM_ID=70316
