{
  "name": "auction-reel-server",
  "version": "1.0.0",
  "description": "Autonomous pipeline turning livestream auctions into animated vertical reels",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/src/index.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ tests/ --ext .ts",
    "lint:fix": "eslint src/ tests/ --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "seed": "ts-node scripts/seed_dummy_job.ts",
    "seed:70316": "ts-node scripts/seed_stream_70316.ts",
    "seed:70299": "ts-node scripts/seed_stream_70299.ts",
    "seed:70277": "ts-node scripts/seed_stream_70277.ts",
    "cron:discovery": "ts-node scripts/discovery_cron.ts",
    "setup:subscription": "ts-node scripts/create_auction_reel_subscription.ts",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "auction",
    "reels",
    "express",
    "ffmpeg",
    "libass",
    "video-pipeline"
  ],
  "author": "Zoop Platform Team",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.693.0",
    "@google-cloud/pubsub": "^6.3.2",
    "@google-cloud/secret-manager": "^5.6.0",
    "@google-cloud/storage": "^7.14.0",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "firebase-admin": "^12.7.0",
    "fontkit": "^2.0.4",
    "jsonwebtoken": "^9.0.2",
    "p-limit": "^3.1.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.6",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
